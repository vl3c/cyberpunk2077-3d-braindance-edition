#include <winver.h>
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION BD3D_VERSION_MAJOR, BD3D_VERSION_MINOR, BD3D_VERSION_PATCH, 0
PRODUCTVERSION BD3D_VERSION_MAJOR, BD3D_VERSION_MINOR, BD3D_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "3D Braindance Edition contributors"
#ifdef BD3D_AUTOSETUP
            VALUE "FileDescription", "3D Braindance Edition: RED4ext plugin that registers the Odyssey 3D SDK stand-in"
            VALUE "InternalName", "Braindance3D"
            VALUE "OriginalFilename", "Braindance3D.dll"
#else
            VALUE "FileDescription", "3D Braindance Edition: independent Odyssey 3D SDK stand-in for Cyberpunk 2077 (not Samsung software)"
            VALUE "InternalName", "Odyssey3DSDK"
            VALUE "OriginalFilename", "Odyssey3DSDK.dll"
#endif
            VALUE "FileVersion", BD3D_VERSION_STR
            VALUE "LegalCopyright", "Copyright (c) 2026 vl3c. MIT License. Not affiliated with CD PROJEKT RED or Samsung."
            VALUE "ProductName", "3D Braindance Edition"
            VALUE "ProductVersion", BD3D_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
